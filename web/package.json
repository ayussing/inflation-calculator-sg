{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:check": "tsx --env-file-if-exists=.env.local scripts/check-db.ts",
    "migrate:up": "tsx --env-file-if-exists=.env.local scripts/migrate.ts up",
    "migrate:down": "tsx --env-file-if-exists=.env.local scripts/migrate.ts down",
    "migrate:create": "node-pg-migrate create -j sql",
    "ingest:cpi": "tsx --env-file-if-exists=.env.local scripts/ingest-cpi.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "csv-parse": "^7.0.2",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "swagger-ui-react": "^5.33.0",
    "zod": "^4.6.5",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-ui-react": "^5.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "fast-check": "^4.10.1",
    "node-pg-migrate": "^9.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
