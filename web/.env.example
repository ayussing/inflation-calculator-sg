# Copy to .env.local and fill in with your Aiven Postgres service URI
# (Aiven console -> your Postgres service -> Connection information -> Service URI).
DATABASE_URL=postgres://user:password@host:port/defaultdb?sslmode=require

# data.gov.sg developer API key (optional; works without one at lower rate limits, which is fine
# for a single scheduled ingestion run per day/month). Obtain via the data.gov.sg dashboard.
DATA_GOV_SG_API_KEY=

# Shared secret GET /api/ingest requires as `Authorization: Bearer <value>` to trigger a CPI
# ingestion run (e.g. from a scheduler). Generate a random string, e.g. `openssl rand -hex 32`.
INGEST_SECRET=
